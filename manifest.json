{
  "manifest_version": 3,
  "name": "Reel Meter",
  "version": "1.2.4",
  "description": "Counts and limits the Shorts, Reels and TikToks you watch, and can block them. Everything stays on your device.",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Reel Meter",
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/ui/dashboard.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/core.js",
      "src/background.js"
    ]
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://www.instagram.com/*",
        "https://www.tiktok.com/*",
        "https://m.tiktok.com/*",
        "https://*.facebook.com/*"
      ],
      "js": [
        "src/core.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'none'; object-src 'self'; frame-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "reel-meter@example.local",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
